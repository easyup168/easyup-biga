#!/usr/bin/env bash
# biga-card —— 出一张决策卡，或看已有的卡。
#
# 为什么要有这个脚本
# ------------------
# 在它之前，出一张卡要手敲一段很长的提示词，而且**漏一句就会出问题**：
#
#   · 漏 `--session-key`  ⇒ 用默认会话，一轮 end_turn 就返回，卡不出来
#   · 漏「带上决策编号」  ⇒ Specialist 用临时号，落库直接报错
#   · 漏「等全部结算」    ⇒ 两次运行交叠（2026-09-21 真出过一次）
#
# 这些都属于「靠人记得」的约定 —— 而本项目反复证明那类约定会失效。
# ⇒ 固化成一条命令。
#
# 用法
#   bin/biga-card                 出一张新卡（等它跑完，然后渲染）
#   bin/biga-card --show <决策号>  看一张已有的卡
#   bin/biga-card --list [n]      列出最近 n 张（默认 10）
#   bin/biga-card --check <决策号> 用冻结证据重跑，断言**组装结果**逐字段相同
#                                （验的是管线无损，不是「结论能被独立复算」——见 F14）
#
# ⚠️ 出一张新卡实测需要 **3 分钟左右**、约 $1.2。不是瞬时操作。

set -uo pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$ROOT" || exit 2

# ══ 🔴 总闸（2026-09-21 21:47 事故期间加的紧急止血）══════════════════
#
# 存在这个文件就一律拒绝出新卡。放在**最前面**，在任何花钱的动作之前。
# 只拦「出新卡」，不拦 --show / --list / --check（那些不花钱，事故排查要用）。
#
# 为什么是文件而不是环境变量：环境变量只对「记得导出它的那个 shell」有效，
# 而雪崩的触发源是**几十个各自独立的进程组**，它们的 env 我控制不了。
# 文件是所有路径都绕不过去的同一个事实。
BIGA_STOP_FILE="${BIGA_STOP_FILE:-$ROOT/.biga-card-stop}"
# ⚠️ 可覆盖**只为测试**：验「取不到提示词就停」时必须能证明
#    那条昂贵的 agent 调用**根本没被走到**（一次真跑 3 分钟 / $1.3）。
#    第一版测试没这个缝，探针把守卫改成 fail-open 之后，
#    测试当场把真实出卡流程跑了起来 —— **一个坏掉时会花钱的测试**。
BIGA="${BIGA:-$HOME/.openclaw-biga/bin/biga}"
PY=python3

_sql() { $PY - "$@" <<'EOF'
import sys, pathlib
sys.path.insert(0, "skills")
from _store import db
with db.connect(readonly=True) as c:
    for r in c.execute(sys.argv[1]):
        print("\t".join("" if x is None else str(x) for x in r))
EOF
}

case "${1:-}" in
  --show)
    [ -n "${2:-}" ] || { echo "用法: biga-card --show <决策号>" >&2; exit 2; }
    exec $PY skills/decision-card/scripts/replay.py "$2"
    ;;
  --check)
    [ -n "${2:-}" ] || { echo "用法: biga-card --check <决策号>" >&2; exit 2; }
    exec $PY skills/decision-card/scripts/replay.py "$2" --check
    ;;
  --list)
    n=${2:-10}
    printf '%-22s %-7s %-14s %s\n' "决策号" "状态" "生成时间" "缺失项"
    _sql "SELECT decision_id, status, generated_at, missing_count
          FROM decision_records ORDER BY rowid DESC LIMIT $n" |
      while IFS=$'\t' read -r id st at mc; do
        printf '%-22s %-7s %-14s %s\n' "$id" "$st" "${at:5:5} ${at:11:5}" "$mc"
      done
    exit 0
    ;;
  -h|--help)
    sed -n '2,25p' "$0" | sed 's/^# \?//'
    exit 0
    ;;
  "") : ;;
  *)
    echo "未知参数 $1（-h 看用法）" >&2; exit 2
    ;;
esac

# ── 出新卡 ───────────────────────────────────────────────────────

# 🔴 总闸优先于一切 —— 它必须在第一个花钱的动作**之前**。
if [ -e "$BIGA_STOP_FILE" ]; then
  echo "🔴 出新卡已被总闸拦下。" >&2
  echo "   闸门文件：$BIGA_STOP_FILE" >&2
  sed 's/^/   │ /' "$BIGA_STOP_FILE" >&2 2>/dev/null
  echo "   解除：rm $BIGA_STOP_FILE（解除前先确认触发源已经停了）" >&2
  echo "   看已有的卡不受影响：bin/biga-card --list / --show <决策号>" >&2
  exit 3
fi

# 🔴 单实例锁 —— 递归与并发的止损（2026-09-21 21:03–21:50 事故）
# ------------------------------------------------------------------
# 那次雪崩的形状是**递归**，不是误触：
#
#   bin/biga-card → $BIGA agent --agent main → 新的 main 会话
#                                                 ↓ 读 AGENTS.md
#                                           bin/biga-card → …
#
# 因为 `AGENTS.md` 当时写着「🔴 要出卡？跑这一条」并贴出了这条命令，
# 而这条命令做的事就是把编排提示词喂给 `main` —— 也就是那个读到这句话的人。
# 实测 187 个 main 会话 / 约 195 次调用，其中 92 次是那行命令的逐字复制。
#
# 契约那一侧已经改了（`AGENTS.md` 现在写「绝对不要运行它」）。
# 但本项目的第一课就是**契约写了不等于会被遵守** ——
# 同一天 19:31 那次「四个 spawn 无归属」，规则也一条不缺地写在契约里。
# ⇒ 机器这一侧必须自己拦。
#
# 为什么用 flock 而不是环境变量：
#   env 传不过网关。`$BIGA agent` 起的会话在**另一个进程树**里，
#   `BIGA_CARD_DEPTH=1` 这种标记根本到不了下一层。
#   而文件锁是所有层都看得见的同一个事实。
#
# ⚠️ 锁**不替代** `AGENTS.md` 那条规则 —— 它只保证「照抄了也只死一次」。
if [ "${BIGA_CARD_NOLOCK:-0}" != "1" ]; then
  exec 9>"$ROOT/.biga-card.lock" || exit 2
  if ! flock -n 9; then
    echo "🔴 已经有一次出卡在跑，这次不再起（单实例锁）。" >&2
    echo "   锁文件：$ROOT/.biga-card.lock" >&2
    echo "   如果你是 agent：**不要调这条命令**，见 AGENTS.md「绝对不要运行」一节。" >&2
    echo "   看在跑的那次：bin/biga-card --list 3" >&2
    exit 3
  fi
fi

# 🔴 预算闸门要在**第一个花钱的动作之前**跑一次（2026-09-21 21:42 事故）
# ------------------------------------------------------------------
# 闸门本来就在路上 —— `new_decision.py` 的 Stage 0 占号之前。
# 事故当天它**开火了约 58 次**，今天只放行了 2 个号，挡住的正是贵的那部分
# （58 × 一次 fan-out ≈ $48）。
#
# ⚠️ 但它漏掉了一笔：`bin/biga-card` 先把一整个 `main` LLM 轮次付掉，
#    才走到闸门那里被拒。实账：雪崩窗口 32 个 main 轮次 = **$8.99**，
#    而同期只出了一张卡。
#
# > 闸门装在**身份**的咽喉点（占号），而**成本**的边界比它早一步。
# > 「唯一入口」这个原则是对的，选错的是「哪一处才算入口」——
# > 对花钱的事，入口是**第一次花钱的地方**，不是第一次产生事实的地方。
#
# ⇒ 同一个判据在这里预跑一次。不是第二套口径：它 import 的是同一个
#   `check_budget()`，阈值只有一份（L-3）。这里拒绝的代价是 $0。
if [ "${BIGA_CARD_FORCE:-0}" != "1" ]; then
  GATE=$($PY - <<'EOF' 2>&1
import sys
sys.path.insert(0, "skills")
sys.path.insert(0, "skills/decision-card/scripts")
from budget import check_budget, explain
r = check_budget()
if r:
    print(explain(r)); sys.exit(3)
EOF
  )
  if [ $? -ne 0 ]; then
    echo "$GATE" >&2
    echo >&2
    echo "   ⓘ 这次拦下的代价是 \$0 —— 闸门在 agent 调用**之前**。" >&2
    echo "     确实要跑：BIGA_CARD_FORCE=1 bin/biga-card" >&2
    exit 3
  fi
fi

BEFORE=$(_sql "SELECT COALESCE(MAX(decision_id),'') FROM decision_records")
SESS="card-$(date +%H%M%S)"
echo "▸ 会话 $SESS   起 $(date +%T)"
echo "  （实测 3 分钟左右、约 \$1.2；期间可以做别的事）"

# 🔴 提示词**不写在这里** —— 从 ORCHESTRATION.md 的标记块里抽。
#
#    原来这段和 AGENTS.md 的 Stage 0~3 是同一段话的两份实现。
#    实测：脚本这份 100% 被执行，契约那份在飞书路径下悄悄失效
#    （4 spawn + yield + 占号在后，$0.4 白花）。
#    ⇒ 合并成一份，这里只负责取出来。改步骤请改那个文件。
ORCH="skills/decision-card/ORCHESTRATION.md"
PROMPT=$(sed -n '/<!-- PROMPT:BEGIN -->/,/<!-- PROMPT:END -->/p' "$ORCH" 2>/dev/null \
         | sed '1d;$d')
if [ -z "${PROMPT// /}" ]; then
  echo "🔴 取不到编排提示词：$ORCH 里没有 PROMPT 标记块。" >&2
  echo "   没有它就只能让 Supervisor 凭契约自己编排 —— 实测会出错，所以直接停。" >&2
  exit 2
fi

"$BIGA" agent --agent main --session-key "agent:main:$SESS" --timeout 900 \
  -m "$PROMPT" >/dev/null 2>&1

# agent 命令返回时卡未必已落库（Supervisor 可能还会被唤醒几轮）
echo -n "▸ 等待落库 "
for _ in $(seq 60); do
  NOW=$(_sql "SELECT COALESCE(MAX(decision_id),'') FROM decision_records")
  if [ "$NOW" != "$BEFORE" ]; then
    echo "→ $NOW  $(date +%T)"
    echo
    $PY skills/decision-card/scripts/replay.py "$NOW"
    echo
    # 🔴 外部评审 F3：「Specialist 真的被调用过」这条最硬的约束，
    #    此前**没有任何机器在管** —— 唯一能做真区分的核验只认
    #    "emotion" 一个名字，而且从不在任何自动化流程里。
    #
    #    ⚠️ 手工跑 skill 再把 verdict_ref 喂给 synthesize.py，产出的
    #      Card 与 agent_runs 记录，和「真的 spawn 了」逐字节相同 ——
    #      两份都是 BigA 自己写的。区分它们只能靠 OpenClaw 运行时
    #      自己记的那张表，而那张表 BigA 业务代码碰不到。
    #
    #    ⇒ 接在出卡之后，因为**这里是唯一每次都会跑到的地方**。
    #      放进 pytest 不行：它需要一次真实运行。
    #    🔴 **它的退出码必须被用上，否则它只是一句打印。**
    #
    #    外部深度评审指出：这里原来是裸调用，紧接着无条件 `exit 0`，
    #    而脚本用的是 `set -uo pipefail`（没有 `-e`）⇒
    #
    #        spawn_check exit 1  →  biga-card 仍 exit 0
    #        spawn_check exit 2  →  biga-card 仍 exit 0
    #
    #    真实语义是「跑了一次检查并打印结果」，
    #    不是「spawn 证明是出卡流程的验收 Gate」。
    #
    #    ⚠️ 我自己那条守卫也没抓到 —— 它只查脚本里**有没有这个字符串**。
    #      调用在、退出码被丢，守卫照样绿。
    $PY tools/verify/spawn_check.py "$NOW"
    SPAWN_RC=$?
    echo
    echo "▸ 延迟与成本：python3 tools/verify/latency_report.py --parallel-check"
    if [ "$SPAWN_RC" -ne 0 ]; then
      echo >&2
      echo "🔴 spawn 核验未通过（rc=$SPAWN_RC）。" >&2
      echo "   卡已落库，但**不能证明 Specialist 真的被调用过** ——" >&2
      echo "   这张卡不要当证据用。" >&2
      echo "   rc=1 有伪造 · rc=2 判不了（读不到运行时记录）" >&2
      echo "   细节：python3 tools/verify/spawn_check.py $NOW" >&2
      # ⚠️ 仍然把卡渲染出来了（上面已经渲染）——
      #    出卡这件事已经发生、钱已经花了，藏起来没有意义。
      #    要变的是**这条命令的成败**，而不是要不要给人看。
      exit 4
    fi
    exit 0
  fi
  echo -n "."
  sleep 5
done

echo
echo "⚠️  5 分钟内没有新卡落库。" >&2
echo "   这**不代表失败** —— 按契约，一次提问要么出卡、要么说清为什么出不了。" >&2
echo "   查这两处：" >&2
echo "     python3 tools/verify/agent_trace.py --agent main -n 1   # 它最后在做什么" >&2
echo "     bin/biga-card --list                                     # 卡是不是晚到了" >&2
exit 1
