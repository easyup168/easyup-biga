[Unit]
Description=定期跑 BigA stale-run-reaper，收敛被信号杀死后卡住的 run（profile: biga）

[Timer]
# 开机 2 分钟后先跑一次（给系统一点启动缓冲），之后每 2 分钟跑一次——与
# notify-worker-biga.timer 同一个节奏，理由也相同：一次真实出卡要
# 170~200s，2 分钟的检查间隔已经足够「近实时」发现卡住的 run；默认阈值
# 1200s（DEFAULT_THRESHOLD_SEC，见 stale_run_reaper.py）意味着一个卡住的
# run 会在卡住后 20~22 分钟内被发现并收成 TIMEOUT，不是立刻。
# 队列没有 stale run 时这条检查只是一次 JOIN 查询，频率再高也谈不上浪费。
OnBootSec=2min
OnUnitActiveSec=2min
Unit=stale-run-reaper-biga.service

[Install]
WantedBy=timers.target
